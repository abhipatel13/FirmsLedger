# ── Required ──────────────────────────────────────────────────────────────────
# Neon Postgres connection string. Without it, src/db/client.ts exports db as
# null and apiClient.js falls through to mock data. Must also be set in Vercel.
DATABASE_URL=

# ── Admin access ──────────────────────────────────────────────────────────────
# NOTE: ADMIN_EMAIL and ADMIN_PASSWORD are NO LONGER USED (removed 2026-09-09).
#
# Admin is now a flag on a real account — `users.is_admin` — with a scrypt
# password hash in the database, so there is no admin secret in the
# environment at all. To grant admin:
#
#   UPDATE users SET is_admin = true WHERE email = 'you@example.com';
#
# The account signs in at /admin with its normal password. GET /api/admin/login
# reports whether any admin account exists, without revealing anything.
#
# The old scheme kept the password in plaintext here AND used it as the HMAC key
# for the admin session cookie, so knowing that one string was enough to forge
# an admin session without logging in.

# ── Email (optional; features degrade quietly when unset) ─────────────────────
# Claim, lead, review and invite notifications are skipped when this is absent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_SUBMISSION_EMAIL=

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Public ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=

# ── Cloudflare R2 (image hosting) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Stripe (present but NOT wired into the claim flow) ────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_FEATURED_PRICE_ID=
